---
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import { LOCALE_TAGS, type Locale, type RouteKey } from '../i18n/config';

interface Props {
	title: string;
	description: string;
	lang: Locale;
	route: RouteKey;
}

const { title, description, lang, route } = Astro.props;
---

<!doctype html>
<html lang={LOCALE_TAGS[lang]}>
	<head>
		<Seo title={title} description={description} lang={lang} route={route} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=block" rel="stylesheet">
		<ClientRouter />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0a0a16;
		--text-color: #e0e6ed;
		--accent-backend: #ff6b6b;
		--accent-ds: #4dabf7;
		--accent-ai: #cc5de8;
		--accent-hub: #ffd43b;
		--accent-exp: #63e6be;
		--card-bg: rgba(255, 255, 255, 0.05);
		--card-border: rgba(255, 255, 255, 0.1);

		/* Responsive Scales */
		--map-scale: 1;
		--char-scale: 1;
		--font-multiplier: 1;
	}

	@media (max-width: 1023px) and (max-height: 869px) {
		:root {
			--map-scale: 0.8;
			--char-scale: 0.8;
			--font-multiplier: 0.85;
		}
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
		font-family: 'Press Start 2P', system-ui, cursive !important;
	}

	html, body {
		background: var(--bg-color);
		color: var(--text-color);
		overflow: hidden;
		height: 100vh;
		width: 100vw;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	h1, h2, h3, p, span, button {
		font-family: 'Press Start 2P', cursive !important;
		font-weight: 400; /* Most pixel fonts only have 400 */
	}
</style>

---
// Everything on this page is rendered HERE, in the frontmatter, at build time.
// That is the whole point: `astro build` executes this block on the build machine
// and writes the resulting markup into the output HTML. A crawler that never runs
// JavaScript still sees every project, every number and every link.
import { sections, allProjects, CONTACT } from '../data/projects';
import { ui } from '../i18n/ui';
import { routePath, otherLocale, LOCALE_NAMES, type Locale } from '../i18n/config';
import { withBase } from '../lib/url';

interface Props { lang: Locale }
const { lang } = Astro.props;

const other = otherLocale(lang);
const projectCount = allProjects.filter((p) => p.repo).length;

const highlights = [
	{ figure: '1,000 req/s', label: ui.hl1[lang] },
	{ figure: '1.75M', label: ui.hl2[lang] },
	{ figure: '10.26×', label: ui.hl3[lang] },
	{ figure: '0.855+', label: ui.hl4[lang] },
];

const stack = [
	'Python', 'Rust', 'Go', 'FastAPI', 'Axum', 'Actix-Web', 'Django',
	'PostgreSQL', 'Redis', 'Qdrant', 'Docker', 'CI/CD', 'XGBoost',
	'sentence-transformers', 'ONNX Runtime',
];

// JSON-LD so the project list is machine-readable too, not just human-readable.
const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'Projects by Joaquin Alvarado',
	numberOfItems: allProjects.length,
	itemListElement: allProjects.map((p, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		item: {
			'@type': 'SoftwareSourceCode',
			name: p.name,
			description: p.tagline[lang],
			...(p.repo ? { codeRepository: p.repo } : {}),
			programmingLanguage: p.tech.join(', '),
		},
	})),
};
---

<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} is:inline />

<a class="skip" href="#work">{ui.skipToProjects[lang]}</a>

<div class="page">
	<header class="hero">
		<div class="topbar">
			<p class="eyebrow">{ui.location[lang]}</p>
			<a class="lang-switch" href={withBase(routePath('projects', other))} hreflang={other} lang={other}>
				{ui.switchLanguage[lang]}
			</a>
		</div>

		<h1>{ui.role[lang]}</h1>
		<p class="lede">{ui.lede[lang]}</p>

		<ul class="links" aria-label={ui.contact[lang]}>
			<li><a href={CONTACT.github} rel="me noopener">GitHub&nbsp;→</a></li>
			<li><a href={CONTACT.linkedin} rel="me noopener">LinkedIn&nbsp;→</a></li>
			<li><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}&nbsp;→</a></li>
			<li><a href={withBase(routePath('home', lang))}>{ui.interactiveLink[lang]}&nbsp;→</a></li>
		</ul>

		<ul class="stack" aria-label={ui.primaryStack[lang]}>
			{stack.map((t) => <li>{t}</li>)}
		</ul>
	</header>

	<section class="highlights" aria-label={ui.selectedFigures[lang]}>
		{highlights.map((h) => (
			<div class="highlight">
				<span class="figure mono">{h.figure}</span>
				<span class="figure-label">{h.label}</span>
			</div>
		))}
	</section>

	<nav class="toc" aria-label={ui.sectionsNav[lang]}>
		{sections.map((s) => <a href={`#${s.id}`}>{s.title[lang]}</a>)}
	</nav>

	<main id="work">
		{sections.map((section) => (
			<section class="group" id={section.id} style={`--accent: ${section.accent}`}>
				<div class="group-head">
					<h2>{section.title[lang]}</h2>
					<p class="group-intro">{section.intro[lang]}</p>
				</div>

				<ol class="cards">
					{section.projects.map((p) => (
						<li class="card">
							<div class="card-head">
								<h3>{p.repo ? <a href={p.repo} rel="noopener">{p.name}</a> : p.name}</h3>
								{p.featured && <span class="badge">{ui.featured[lang]}</span>}
							</div>

							<p class="tagline">{p.tagline[lang]}</p>
							<p class="blurb">{p.blurb[lang]}</p>

							<ul class="metrics">
								{p.metrics[lang].map((m) => <li>{m}</li>)}
							</ul>

							{p.role && <p class="role">{p.role[lang]}</p>}

							<ul class="tech" aria-label={ui.technologies[lang]}>
								{p.tech.map((t) => <li class="mono">{t}</li>)}
							</ul>

							<p class="actions">
								{p.repo && <a class="action" href={p.repo} rel="noopener">{ui.sourceCode[lang]}&nbsp;↗</a>}
								{p.link && <a class="action" href={p.link.url} rel="noopener">{p.link.label[lang]}&nbsp;↗</a>}
								{p.demo && <a class="action" href={p.demo} rel="noopener">{ui.liveDemo[lang]}&nbsp;↗</a>}
								{!p.repo && !p.link && <span class="action muted">{p.noRepoReason?.[lang]}</span>}
							</p>
						</li>
					))}
				</ol>
			</section>
		))}
	</main>

	<footer class="foot">
		<p>
			{ui.entriesWithSource[lang](allProjects.length, projectCount)}{' '}
			{ui.footerNote[lang]}
		</p>
		<p class="foot-links">
			<a href={withBase(routePath('home', lang))}>{ui.backToGame[lang]} →</a>
			<a href={withBase(routePath('projects', other))} hreflang={other} lang={other}>{LOCALE_NAMES[other]} →</a>
			<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
		</p>
	</footer>
</div>

<style>
	.skip { position: absolute; left: -9999px; top: 0; background: var(--bg-raised); padding: 0.6rem 1rem; z-index: 10; }
	.skip:focus { left: 0.5rem; top: 0.5rem; }

	.page {
		max-width: 68rem;
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 4rem) clamp(1.1rem, 4vw, 2.5rem) 5rem;
	}

	/* ---------- hero ---------- */
	.topbar {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.8rem 1.5rem;
		margin-bottom: 0.9rem;
	}

	.eyebrow { color: var(--text-faint); font-size: 0.85rem; letter-spacing: 0.09em; text-transform: uppercase; }

	.lang-switch {
		font-size: 0.82rem;
		font-weight: 600;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		padding: 0.28rem 0.85rem;
		white-space: nowrap;
	}
	.lang-switch:hover { text-decoration: none; border-color: var(--link); }

	h1 {
		font-size: clamp(1.85rem, 5.2vw, 3.1rem);
		line-height: 1.12;
		letter-spacing: -0.022em;
		margin-bottom: 1.1rem;
		font-weight: 700;
	}

	.lede { color: var(--text-dim); font-size: clamp(1rem, 2.1vw, 1.12rem); max-width: 46rem; }

	.links {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem 1.4rem;
		margin-top: 1.5rem;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.stack { list-style: none; display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 1.6rem; }
	.stack li {
		font-size: 0.78rem;
		color: var(--text-dim);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.22rem 0.65rem;
	}

	/* ---------- highlights ---------- */
	.highlights {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: 10px;
		overflow: hidden;
		margin: 3rem 0 2.5rem;
	}
	.highlight { background: var(--bg-raised); padding: 1.25rem 1.15rem; display: flex; flex-direction: column; gap: 0.35rem; }
	.figure { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
	.figure-label { font-size: 0.82rem; color: var(--text-faint); line-height: 1.45; }

	/* ---------- toc ---------- */
	.toc {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--border);
		font-size: 0.9rem;
		font-weight: 600;
	}

	/* ---------- sections ---------- */
	.group { padding-top: 3.5rem; scroll-margin-top: 1.5rem; }
	.group-head { margin-bottom: 1.75rem; }

	h2 {
		font-size: clamp(1.3rem, 3.2vw, 1.7rem);
		letter-spacing: -0.015em;
		padding-left: 0.85rem;
		border-left: 4px solid var(--accent);
		line-height: 1.25;
	}

	.group-intro { color: var(--text-faint); max-width: 48rem; margin-top: 0.7rem; padding-left: 1.1rem; font-size: 0.95rem; }

	.cards { list-style: none; display: grid; gap: 1.1rem; }

	.card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		border-radius: 10px;
		padding: 1.5rem clamp(1.1rem, 3vw, 1.75rem);
	}

	.card-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.7rem; }

	h3 { font-size: 1.16rem; letter-spacing: -0.01em; font-weight: 700; }
	h3 a { color: var(--text); }
	h3 a:hover { color: var(--accent); text-decoration: none; }

	.badge {
		font-size: 0.66rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--accent);
		border: 1px solid var(--accent);
		border-radius: 999px;
		padding: 0.1rem 0.5rem;
		opacity: 0.85;
	}

	.tagline { color: var(--accent); font-size: 0.9rem; margin-top: 0.2rem; opacity: 0.92; }
	.blurb { color: var(--text-dim); margin-top: 0.85rem; max-width: 54rem; }

	.metrics { list-style: none; margin-top: 1.05rem; display: grid; gap: 0.42rem; }
	.metrics li { position: relative; padding-left: 1.15rem; font-size: 0.9rem; color: var(--text); }
	.metrics li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.62em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--accent);
	}

	.role { margin-top: 0.95rem; font-size: 0.85rem; color: var(--text-faint); font-style: italic; }

	.tech { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.15rem; }
	.tech li {
		font-size: 0.74rem;
		color: var(--text-faint);
		background: rgba(255, 255, 255, 0.045);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 0.16rem 0.5rem;
	}

	.actions { margin-top: 1.2rem; display: flex; flex-wrap: wrap; gap: 1.3rem; font-size: 0.9rem; font-weight: 600; }
	.action.muted { color: var(--text-faint); font-weight: 400; font-style: italic; }

	/* ---------- footer ---------- */
	.foot {
		margin-top: 4.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
		color: var(--text-faint);
		font-size: 0.88rem;
		display: grid;
		gap: 0.9rem;
		max-width: 52rem;
	}
	.foot-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; font-weight: 600; }

	@media print {
		.skip, .toc, .badge, .lang-switch { display: none; }
		.page { max-width: none; }
	}
</style>

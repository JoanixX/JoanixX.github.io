---
import Layout from '../../layouts/Layout.astro';
import GameMap from '../../components/GameMap.astro';
import Dashboard from '../../components/Dashboard.astro';
import ZoneModal from '../../components/ZoneModal.astro';
import StartScreen from '../../components/StartScreen.astro';
import { ui } from '../../i18n/ui';

const lang = 'es' as const;
---

<Layout title={ui.homeTitle[lang]} description={ui.homeDescription[lang]} lang={lang} route="home">
	<main>
		<StartScreen lang={lang} />
		<Dashboard lang={lang} />
		<GameMap lang={lang} />
		<ZoneModal lang={lang} />
	</main>
</Layout>

<style>
	main {
		width: 100%;
		height: 100%;
		position: absolute;
		top: 0;
		left: 0;
	}
</style>
